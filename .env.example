# Copy to .env. Never commit real keys or phone numbers.
# 1=model, 2=Exa, 3=Kernel, 4=Mem0, 5=phone messaging.
WORKSHOP_MILESTONE=1
EXA_API_KEY=
OPENROUTER_API_KEY=
MODEL_NAME=qwen/qwen3.8-27b
MODEL_BASE_URL=https://openrouter.ai/api/v1
# Optional alternative model-provider key:
MODEL_API_KEY=
MEM0_EMBEDDING_MODEL=qwen/qwen3-embedding-4b
MEM0_EMBEDDING_DIMENSIONS=2560
# Keep dimensions matched to the embedding model. Changing them requires reindexing.
# Empty uses the model endpoint/key above.
MEM0_EMBEDDING_BASE_URL=
MEM0_EMBEDDING_API_KEY=
# Milestone 3: rendered page inspection in a Kernel cloud browser:
KERNEL_API_KEY=
AGENT_TIMEZONE=America/Los_Angeles
# The complete demo supports linq (default) or whatsapp. Starter TODO 5 uses Linq.
MESSAGING_CHANNEL=linq
# Optional Linq reactions: local (keyword matching) or jev (OpenRouter Decisions API).
REACTION_MODE=local
LINQ_API_KEY=
LINQ_WEBHOOK_SECRET=
LINQ_PHONE_NUMBER=
OWNER_PHONE_NUMBER=
# Optional WhatsApp Cloud API channel; Linq credentials are not needed for it.
# Follow docs/WHATSAPP.md. Copy a supported version from Meta's API Setup (vNN.0).
WHATSAPP_API_VERSION=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
PORT=3400
DATA_DIR=.data
