{
  "name": "aie-code-personal-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=26.12.1"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.ts",
    "chat": "node --env-file-if-exists=.env src/cli.ts",
    "doctor": "node --env-file-if-exists=.env src/doctor.ts",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "starter:chat": "node --env-file-if-exists=.env starter/cli.ts",
    "starter:phone": "node --env-file-if-exists=.env starter/server.ts",
    "solution:chat": "node --env-file-if-exists=.env src/cli.ts",
    "solution:phone": "node --env-file-if-exists=.env src/server.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@onkernel/sdk": "0.141.0",
    "mem0ai": "3.3.1",
    "openai": "4.104.0"
  },
  "description": "Build a laptop-hosted personal agent with Exa, Mem0, Kernel, and Linq",
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
